{
  "name": "obsidian-semantic-autolinker",
  "version": "1.0.0",
  "description": "Local-first Obsidian plugin for semantic auto-linking, knowledge graphs, and relationship discovery without external AI or cloud APIs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "autolink",
    "knowledge-graph",
    "semantic-search",
    "tf-idf",
    "cytoscape"
  ],
  "author": "Vedha",
  "license": "MIT",
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.13.1",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "cytoscape": "^3.30.4"
  }
}
